# PostgreSQL: local LAN, Neon, Supabase, AWS RDS, Railway, etc.
# Never commit a real password or network address.
DATABASE_URL="postgresql://rainbow_app:replace-with-a-strong-password@192.168.1.50:5432/rainbow_school?schema=public"

# Comma-separated frontend origins allowed to submit public enquiries.
# In production set this to your custom domain and Vercel domain.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
