# Google Apps Script Web App Endpoint for Admissions Enquiries
# Replace with the deployed Web App URL (must end with /exec)
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbx.../exec"

# Shared secret key between Vercel serverless function and Google Apps Script
# Must match the SHARED_SECRET Script Property configured in Google Apps Script (min 16 chars)
GOOGLE_APPS_SCRIPT_SECRET="replace-with-a-cryptographically-secure-random-string-at-least-32-chars"

# Comma-separated frontend origins allowed to submit public enquiries.
# In production set this to your custom domain and Vercel domain.
# Required: submissions fail closed when unset. Add the exact deployed HTTPS origin.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://rainbow-digi-school.vercel.app"

# Optional legacy local SQLite reader only: set a random token of at least 32 characters.
# Never expose this legacy reader publicly; it binds to loopback by default.
LEGACY_ADMIN_TOKEN=""
