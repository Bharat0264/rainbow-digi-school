# PostgreSQL: local LAN, Neon, Supabase, AWS RDS, Railway, etc.
# Never commit a real password or network address.
DATABASE_URL="postgresql://rainbow_app:replace-with-a-strong-password@localhost:5432/rainbow_school?schema=public"

# Comma-separated frontend origins allowed to submit public enquiries.
# In production set this to your custom domain and Vercel domain.
# Required: submissions fail closed when unset. Add the exact deployed HTTPS origin.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
# Vite alone does not run this Vercel API. Apply Prisma migrations before launch.
# No email/WhatsApp notification provider is configured by this project.
# Optional legacy local SQLite reader only: set a random token of at least 32 characters.
# Never expose this legacy reader publicly; it binds to loopback by default.
LEGACY_ADMIN_TOKEN=""
