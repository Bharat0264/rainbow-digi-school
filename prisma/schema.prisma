generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CAMPUS_VISIT_SCHEDULED
  CAMPUS_VISITED
  APPLICATION_STARTED
  APPLICATION_SUBMITTED
  UNDER_REVIEW
  SELECTED
  ADMISSION_CONFIRMED
  NOT_INTERESTED
  LOST
}

model Enquiry {
  id                 String        @id @default(cuid())
  enquiryNumber      String        @unique
  parentName         String
  mobile             String
  whatsapp           String?
  email              String?
  childName          String
  childDateOfBirth   DateTime?
  interestedProgram  String
  currentSchool      String?
  locality           String?
  preferredCallback  String?
  preferredVisitDate DateTime?
  message            String?
  source             String        @default("WEBSITE")
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  status             EnquiryStatus @default(NEW)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([mobile])
  @@index([status, createdAt])
  @@index([interestedProgram])
}
