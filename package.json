{
  "name": "school",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "start": "vite preview --host 0.0.0.0",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "eslint src scripts/review --max-warnings 0 && oxlint src api --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test:enquiries": "node scripts/check-enquiries.mjs",
    "test:seo": "node scripts/verify-seo.mjs",
    "test:browser": "node scripts/verify-premium.mjs",
    "test:a11y": "node scripts/verify-accessibility.mjs",
    "preview": "vite preview",
    "start:legacy": "concurrently \"npm run dev\" \"npm run server\"",
    "test": "npm run test:enquiries && npm run test:seo && playwright test",
    "test:smoke": "playwright test",
    "analyze": "node scripts/review/analyze.mjs",
    "review:crawl": "node scripts/review/crawl.mjs",
    "review:lighthouse": "node scripts/review/lighthouse.mjs",
    "review:compare": "node scripts/review/compare.mjs",
    "format": "prettier --write src scripts/review tests playwright.config.js eslint.config.js",
    "review:gates": "node scripts/review/gates.mjs"
  },
  "dependencies": {
    "framer-motion": "14.0.0",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.13.0",
    "knip": "6.42.1",
    "lighthouse": "13.5.0",
    "oxlint": "1.87.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "postcss": "8.5.29",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "packageManager": "npm@11.6.2"
}
